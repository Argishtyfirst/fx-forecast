# Copy to .env. Secrets live in environment variables only (NFR-06).
DATABASE_URL=postgresql+psycopg://fxf:fxf@localhost:5433/fxf
TEST_DATABASE_URL=postgresql+psycopg://fxf:fxf@localhost:5433/postgres

# Optional. Without it, FRED series are read from the public fredgraph.csv endpoint.
FRED_API_KEY=

# Optional. Without it, statements are scored by the deterministic lexicon scorer.
ANTHROPIC_API_KEY=
FXF_SCORER_MODEL=claude-haiku-5-5

# Optional. Turns on the experimental AI view (fxf.ai); scored live, never backtested.
GEMINI_API_KEY=
FXF_AI_MODEL=gemini-3.5-flash-lite

# Optional alert targets (NFR-04). Without them, alerts go to the structured log only.
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
SMTP_URL=

# Where raw source responses are kept for 30 days.
FXF_RAW_DIR=backend/var/raw
GIT_SHA=
